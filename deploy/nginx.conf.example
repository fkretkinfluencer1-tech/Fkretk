# Include this file inside nginx's http {} context (for example conf.d/).
limit_req_zone $binary_remote_addr zone=fikratak_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=fikratak_setup:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=fikratak_password_reset:10m rate=2r/m;
limit_req_zone $binary_remote_addr zone=fikratak_client_login:10m rate=5r/m;
limit_req_status 429;

server {
    listen 80;
    server_name crm.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name crm.example.com;

    ssl_certificate /etc/letsencrypt/live/crm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/crm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The UI caps .xlsx imports at 3 MiB; the JSON import endpoint accepts up to 40 MiB.
    client_max_body_size 45m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";
    proxy_redirect off;

    location ~ /\.(?!well-known/) {
        return 404;
    }

    location ~* ^/(?:data|backups)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:docs?|tests|scripts|deploy|data-access|production-release|influencer-data-collector)(?:/|$) {
        return 404;
    }

    location ~* ^/(?:server\.mjs|package(?:-lock)?\.json|README(?:\.[^/]*)?|DEPLOYMENT(?:\.[^/]*)?)$ {
        return 404;
    }

    location ~* \.(?:env|sqlite(?:-shm|-wal)?|log|map|bak|backup)$ {
        return 404;
    }

    location = /api/login {
        limit_req zone=fikratak_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }

    location = /api/setup {
        limit_req zone=fikratak_setup burst=2 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }

    location ~ ^/api/password-reset-[^/]+$ {
        limit_req zone=fikratak_password_reset burst=2 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }

    location = /api/client-portal/login {
        limit_req zone=fikratak_client_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8765;
    }

    location / {
        proxy_pass http://127.0.0.1:8765;
    }
}
