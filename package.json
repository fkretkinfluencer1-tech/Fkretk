{
  "name": "fikratak-influencer-crm",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:production": "sh ./start-production.sh",
    "start:windows": "start-production.cmd",
    "check": "node --check server.mjs && node scripts/contrast-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "a11y:contrast": "node scripts/a11y-contrast.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "release": "node scripts/create-production-release.mjs",
    "verify:release": "npm run release && node scripts/verify-production-release.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.65.0"
  }
}
