NODE_ENV=production
PORT=8765
FIKRATAK_HOST=127.0.0.1
FIKRATAK_DATA_DIR=/var/lib/fikratak/data
FIKRATAK_BACKUP_DIR=/var/backups/fikratak
FIKRATAK_ALLOWED_ORIGINS=https://crm.example.com
FIKRATAK_TRUSTED_PROXIES=127.0.0.1,::1
# Applies to both /api/login and /api/client-portal/login.
FIKRATAK_LOGIN_MAX_ATTEMPTS=6
FIKRATAK_LOGIN_LOCKOUT_MINUTES=10
# Keep disabled except during a planned, backed-up production import window.
FIKRATAK_IMPORT_ENABLED=0
# Set only for first-admin setup; generate at least 32 random bytes, then remove and restart.
FIKRATAK_SETUP_TOKEN=
# Required by scripts/backup-offsite.sh; use an age public recipient and a dedicated rsync destination.
FIKRATAK_AGE_RECIPIENT=
FIKRATAK_OFFSITE_TARGET=backup@backup.example.net:/srv/fikratak-backups
